# Copy to .env for local overrides. These are placeholders, not production secrets.
# The Compose file supplies obvious local-only defaults so the disposable demo
# database starts without this file. Do not point these at a remote database.

POSTGRES_IMAGE=postgres:17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentgate

# Runtime role passwords. Replace them for any shared environment.
AGENTGATE_API_PASSWORD=local-dev-api-password
AGENTGATE_WORKER_PASSWORD=local-dev-worker-password
AGENTGATE_MIGRATOR_PASSWORD=local-dev-migrator-password

# Set true to load synthetic invoices after migrations.
AGENTGATE_SEED=true

AGENTGATE_HTTP_HOST=127.0.0.1
AGENTGATE_HTTP_PORT=8080
AGENTGATE_DATABASE_URL=postgresql://agentgate_api:local-dev-api-password@127.0.0.1:5432/agentgate
AGENTGATE_WORKER_DATABASE_URL=postgresql://agentgate_worker:local-dev-worker-password@127.0.0.1:5432/agentgate
AGENTGATE_CONTRACTS_DIR=packages/contracts
