{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["pr_id", "revision", "content_hash", "state", "job_id", "receipt"],
  "properties": {
    "pr_id": {"type": "string"},
    "revision": {"type": "integer"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"type": "string", "enum": ["queued", "merged"]},
    "job_id": {"type": "string"},
    "receipt": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_id", "pr_id", "revision", "content_hash", "committed_at", "rows"],
          "properties": {
            "receipt_id": {"type": "string"},
            "pr_id": {"type": "string"},
            "revision": {"type": "integer"},
            "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "committed_at": {"type": "string"},
            "rows": {"type": "array"}
          }
        }
      ]
    }
  }
}
