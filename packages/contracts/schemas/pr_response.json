{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pr_id", "title", "reason", "task_id", "proposer_id", "state", "revision",
    "content_hash", "policy_decision", "policy_version", "expires_at", "created_at",
    "approvals", "execution_status"
  ],
  "properties": {
    "pr_id": {"type": "string"},
    "title": {"type": "string"},
    "reason": {"type": "string"},
    "task_id": {"type": ["string", "null"]},
    "proposer_id": {"type": "string"},
    "state": {"type": "string"},
    "revision": {"type": "integer"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_decision": {"type": "string"},
    "policy_version": {"type": "integer"},
    "expires_at": {"type": "string"},
    "created_at": {"type": "string"},
    "approvals": {"type": "array"},
    "execution_status": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["job_id", "state", "receipt"],
          "properties": {
            "job_id": {"type": "string"},
            "state": {"type": "string", "enum": ["queued", "completed", "failed"]},
            "receipt": {
              "anyOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["receipt_id", "pr_id", "revision", "content_hash", "committed_at", "rows"],
                  "properties": {
                    "receipt_id": {"type": "string"},
                    "pr_id": {"type": "string"},
                    "revision": {"type": "integer"},
                    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "committed_at": {"type": "string"},
                    "rows": {"type": "array"}
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "diff": {"type": "object"}
  }
}
