{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "reason", "expires_in_seconds", "changes"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
    "task_id": {"type": ["string", "null"], "maxLength": 200},
    "expires_in_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "read_tokens": {"type": "array", "items": {"type": "string"}},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["operation", "schema", "table", "key", "expected_revision", "set"],
        "properties": {
          "operation": {"type": "string"},
          "schema": {"type": "string"},
          "table": {"type": "string"},
          "key": {"type": "object", "minProperties": 1},
          "expected_revision": {"type": "string", "pattern": "^[0-9]+$"},
          "set": {"type": "object", "minProperties": 1}
        }
      }
    }
  }
}
