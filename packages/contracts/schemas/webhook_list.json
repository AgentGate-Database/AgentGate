{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["webhooks"],
  "properties": {
    "webhooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "events", "created_at"],
        "properties": {
          "id": {"type": "string"},
          "url": {"type": "string"},
          "events": {"type": "array", "items": {"type": "string"}},
          "created_at": {"type": "string"}
        }
      }
    }
  }
}
