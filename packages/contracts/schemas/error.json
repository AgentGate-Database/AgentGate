{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "UNAUTHORIZED", "FORBIDDEN", "UNSUPPORTED_TABLE", "UNSUPPORTED_OPERATION",
            "POLICY_BLOCKED", "REVISION_MISMATCH", "PR_EXPIRED", "DRIFT_CONFLICT",
            "SCHEMA_CHANGED", "IDEMPOTENCY_CONFLICT", "LIMIT_EXCEEDED",
            "CONSTRAINT_VIOLATION", "VALIDATION_FAILED", "NOT_FOUND", "INTERNAL"
          ]
        },
        "message": {"type": "string"},
        "details": {"type": "object"}
      }
    }
  }
}
